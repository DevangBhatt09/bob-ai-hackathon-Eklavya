# ============================================================
# Mission Readiness & Predictive Maintenance Copilot
# Environment Variables — copy to .env and fill in values
# NEVER commit .env to version control
# ============================================================

# PostgreSQL connection string
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://hums_user:hums_password@localhost:5432/hums_db

# Gemini API key (optional — system works without it)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Application secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-in-production

# Environment: development | production | test
ENVIRONMENT=development

# Backend server settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Synthetic data seed (for reproducibility)
SYNTHETIC_DATA_SEED=42
